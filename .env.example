PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=restaurant_api

# JWT (one identity for diners and staff). Change them outside local dev.
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret

# Public URL of the diner app; table QR codes point to <PUBLIC_APP_URL>/t/<token>.
PUBLIC_APP_URL=http://localhost:5173
