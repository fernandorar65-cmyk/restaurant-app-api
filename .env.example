PORT=3000

DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=restaurant_api
# Only for throwaway local databases: the schema is owned by the migrations.
DB_SYNCHRONIZE=false

# JWT (one identity for diners and staff). Change them outside local dev.
JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret

# Public URL of the diner app; table QR codes point to <PUBLIC_APP_URL>/t/<token>.
PUBLIC_APP_URL=http://localhost:5173

# Automatic stock discount by recipe when a dish goes to PREPARING (off until the business flow is confirmed)
INVENTORY_AUTO_CONSUMPTION=false

# Logs: level (fatal | error | warn | log | debug | verbose) and format (text | json).
# Default: log level; text in development, json in production.
LOG_LEVEL=log
LOG_FORMAT=text
# Errors (error/fatal) are also stored in the error_logs table for this many days.
ERROR_LOG_RETENTION_DAYS=30

# Uploaded images (POST /uploads/images). aws | azure; empty = uploads answer 503.
STORAGE_PROVIDER=
# aws: Amazon S3 or an S3-compatible storage (R2, MinIO through AWS_S3_ENDPOINT).
# Without access keys the SDK uses its default credential chain (IAM role...).
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
# CDN or custom domain for the public URLs (optional).
AWS_S3_PUBLIC_BASE_URL=
# azure: Blob Storage; the container must allow public read or sit behind a CDN.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_PUBLIC_BASE_URL=
